{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "paths": { "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src", "src/preload/index.d.ts", "src/shared-ipc.ts"]
}
