{
  "name": "@fatup/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build -w @fatup/web && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fatup --local",
    "db:migrate:remote": "wrangler d1 migrations apply fatup --remote",
    "token:new": "node scripts/new-token.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fatup/shared": "*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
